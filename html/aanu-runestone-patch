<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>Aanu — Runestone Patch</title>
<style>
  body { background:#0d0b08; color:#c9b97a; font-family:monospace; display:flex; align-items:center; justify-content:center; min-height:100vh; margin:0; }
  .box { background:#1a1710; border:1px solid #3a2f1a; border-radius:10px; padding:32px 40px; max-width:440px; width:100%; text-align:center; }
  h2 { font-size:1.1rem; letter-spacing:0.15em; color:#c9a84c; margin:0 0 8px; }
  p  { font-size:0.8rem; color:#888; margin:0 0 24px; }
  button { background:linear-gradient(135deg,#b8860b,#8b6914); color:#fff8e1; border:none; border-radius:6px; padding:12px 28px; font-family:monospace; font-size:0.85rem; letter-spacing:0.1em; cursor:pointer; width:100%; }
  button:hover { background:linear-gradient(135deg,#d4a017,#a07820); }
  #log { margin-top:20px; font-size:0.75rem; color:#70c090; min-height:20px; white-space:pre-wrap; text-align:left; background:rgba(0,0,0,0.3); border-radius:6px; padding:10px 14px; display:none; }
  #log.visible { display:block; }
</style>
</head>
<body>
<div class="box">
  <h2>⚗️ RUNESTONE PATCH</h2>
  <p>Gives Aanu's account 20x of every runestone grade (E–S) for enchantment testing.</p>
  <button onclick="runPatch()">GIVE RUNESTONES TO AANU</button>
  <div id="log"></div>
</div>

<script type="module">
import { initializeApp } from "https://www.gstatic.com/firebasejs/10.12.0/firebase-app.js";
import { getAuth, onAuthStateChanged } from "https://www.gstatic.com/firebasejs/10.12.0/firebase-auth.js";
import { getFirestore, doc, getDoc, updateDoc } from "https://www.gstatic.com/firebasejs/10.12.0/firebase-firestore.js";

const firebaseConfig = {
  apiKey:            "AIzaSyC6b7VRgI-VFR96kdgkpQyMDFcAJAKqiQk",
  authDomain:        "inkcraftrp.firebaseapp.com",
  projectId:         "inkcraftrp",
  storageBucket:     "inkcraftrp.firebasestorage.app",
  messagingSenderId: "1093291283926",
  appId:             "1:1093291283926:web:8d0ef76c694a8a74aa00ea"
};

const app  = initializeApp(firebaseConfig);
const auth = getAuth(app);
const db   = getFirestore(app);

const RUNESTONES = [
  { name: "E-grade Runestone", qty: 20 },
  { name: "D-grade Runestone", qty: 20 },
  { name: "C-grade Runestone", qty: 20 },
  { name: "B-grade Runestone", qty: 20 },
  { name: "A-grade Runestone", qty: 20 },
  { name: "S-grade Runestone", qty: 20 },
];

const log = (msg) => {
  const el = document.getElementById('log');
  el.classList.add('visible');
  el.textContent += msg + '\n';
};

window.runPatch = async function() {
  const user = auth.currentUser;
  if (!user) { log('❌ Not logged in. Open this file while logged in as Aanu.'); return; }
  log(`✓ Logged in as: ${user.email}`);

  const charRef = doc(db, 'characters', user.uid);
  const snap    = await getDoc(charRef);
  if (!snap.exists()) { log('❌ Character document not found.'); return; }

  const data = snap.data();
  if (!data.name?.toLowerCase().includes('aanu')) {
    log(`⚠️  Character name is "${data.name}" — not Aanu. Proceeding anyway...`);
  }

  const inv = [...(data.inventory || [])];

  for (const stone of RUNESTONES) {
    const existing = inv.find(i => i.name === stone.name);
    if (existing) {
      existing.qty = (existing.qty || 0) + stone.qty;
      log(`  + Added ${stone.qty}x ${stone.name} (now ${existing.qty}x)`);
    } else {
      inv.push({ name: stone.name, qty: stone.qty });
      log(`  + Added ${stone.qty}x ${stone.name} (new)`);
    }
  }

  await updateDoc(charRef, { inventory: inv });
  log('\n✅ Done! Refresh the game dashboard to see your runestones.');
};
</script>
</body>
</html>